# ---- Firebase (Project settings → General → Your apps → Web app config) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Service accounts → Generate new private key. Paste the whole JSON (or base64 of it).
FIREBASE_SERVICE_ACCOUNT=

# ---- Stripe (test mode keys first: sk_test_… / whsec_…) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# off | test | live  — cash games stay hidden while "off"
CASH_MODE=test

# ---- Optional: block VoIP / toll-free numbers at sign-up (Twilio Lookup) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Other ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
# Comma-separated ISO regions where cash play is blocked (defaults below). Confirm with counsel.
# CASH_BLOCKED_REGIONS=US-AZ,US-AR,US-CT,US-DE,US-LA,US-MT,US-SC,US-SD,US-TN

# ---- Gemini (Genkit) — aistudio.google.com → Get API key ----
GEMINI_API_KEY=
